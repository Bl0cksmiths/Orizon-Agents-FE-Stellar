{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  // .next/e2e-demo is the build directory of Playwright's second dev server
  // (see playwright.config.ts). It is listed so `next dev` finds nothing to add.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/e2e-demo/types/**/*.ts"
  ],
  // The weekly tranche bundles are submission evidence, not application
  // sources: they carry the capture scripts the screenshots were made with,
  // which are written to run from `e2e/` and do not resolve from where they
  // are archived. Typechecking them fails the build for no benefit.
  "exclude": ["node_modules", "Week-*-Tranche-Submission"]
}
