{
  "name": "orizon-agents-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run litepaper:assets",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test scripts/evidence-check/*.test.mjs",
    "e2e": "playwright test",
    "e2e:crawl": "playwright test -c playwright.crawl.config.ts",
    "bundle": "node scripts/check-bundle-size.mjs",
    "litepaper:assets": "node scripts/litepaper-assets.mjs",
    "check:addresses": "node scripts/check-contract-addresses.mjs",
    "lighthouse": "npx --yes @lhci/cli autorun",
    "smoke": "node scripts/smoke-deploy.mjs",
    "sitemap:check": "node scripts/sitemap-check.mjs",
    "hero:isr": "node scripts/hero-isr-check.mjs",
    "test:parity": "node --test scripts/live-contract-parity.test.mjs scripts/check-contract-addresses.test.mjs scripts/smoke-deploy.test.mjs scripts/guide-samples/*.test.mjs && npm run guide:check && npm run evidence:check",
    "guide:check": "node scripts/guide-samples/cli.mjs --static",
    "guide:live": "node scripts/guide-samples/cli.mjs --live",
    "guide:offline": "node scripts/guide-samples/cli.mjs --offline",
    "demo:check": "node scripts/demo-check.mjs",
    "evidence:check": "node scripts/evidence-check/cli.mjs --static",
    "evidence:verify": "node scripts/evidence-check/cli.mjs --live",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.1.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "1.5.11",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^2.5.4",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^14.2.15",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.5"
  }
}
